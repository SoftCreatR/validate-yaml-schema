{
  "name": "validate-yaml-schema",
  "version": "3.0.0",
  "description": "Validate YAML files against JSON Schemas in GitHub Actions",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "ncc build src/main.ts --out lib --minify --license licenses.txt",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SoftCreatR/validate-yaml-schema.git"
  },
  "keywords": [
    "github-action",
    "json-schema",
    "validation",
    "yaml"
  ],
  "author": "SoftCreatR",
  "license": "CC0-1.0",
  "bugs": {
    "url": "https://github.com/SoftCreatR/validate-yaml-schema/issues"
  },
  "homepage": "https://github.com/SoftCreatR/validate-yaml-schema#readme",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.6.0",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "glob": "^13.0.6",
    "jsonc-parser": "^3.3.1",
    "vscode-languageserver-textdocument": "^1.0.14",
    "yaml-language-server": "^1.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.4",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
